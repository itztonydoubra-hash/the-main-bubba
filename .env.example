# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# WhatsApp Authentication
# Set USE_PAIRING_CODE=true to use phone number pairing instead of QR code
# This is recommended for servers and when QR code doesn't display properly
USE_PAIRING_CODE=true
# Your WhatsApp phone number with country code, no + or spaces (e.g. 2348012345678)
PAIRING_PHONE=2347051186987

# Bot config
BOT_NAME=Bubba
CHECK_IN_ENABLED=true
CHECK_IN_CRON=0 10 * * *
